DB_SCHEME=postgresql+psycopg
DB_USER=<user>
DB_NAME=<database>
DB_HOST=host.docker.internal
DB_PORT=5432

# Secret file path on the host used by Docker Compose (DEV default)
DB_PASSWORD_FILE_HOST=<path_to_password_file_on_host>

# Production reference (override in prod compose/env)
DB_PASSWORD_FILE_HOST_PROD=<path_to_password_file_on_host_prod>
